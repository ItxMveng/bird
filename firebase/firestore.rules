rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function hasOnlyKeys(data, keys) {
      return data.keys().hasOnly(keys);
    }

    function isAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function transactionForDispute(txId) {
      return get(/databases/$(database)/documents/transactions/$(txId)).data;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && hasOnlyKeys(request.resource.data, ['uid', 'email', 'name', 'city', 'phone', 'role', 'isPro', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'user'
        && (!('status' in request.resource.data) || request.resource.data.status == 'active')
        && (!('isPro' in request.resource.data) || request.resource.data.isPro == false);
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).changedKeys().hasAny(['role', 'status', 'isPro']);
      allow delete: if false;
    }

    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && hasOnlyKeys(request.resource.data, ['uid', 'name', 'city', 'photoUrl']);
      allow delete: if false;
    }

    match /wallets/{uid} {
      allow read: if isOwner(uid);
      allow write: if false; // server-only via Cloud Functions/Admin SDK
    }

    match /wallet_transactions/{txId} {
      allow read: if isAuthenticated() && resource.data.walletId == request.auth.uid;
      allow write: if false;
    }

    match /auctions/{auctionId} {
      allow read: if true;
      allow create: if false; // backend-only to enforce domain invariants
      // Le vendeur peut annuler sa propre annonce tant qu'elle n'a reçu aucune mise.
      allow update: if isAuthenticated()
        && resource.data.sellerId == request.auth.uid
        && resource.data.status == 'active'
        && !('winnerId' in resource.data)
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if false;
    }

    match /bids/{bidId} {
      allow read: if isAuthenticated();
      allow create: if false; // backend-only via Cloud Functions
      allow update, delete: if false;
    }

    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      allow write: if false;
    }

    match /transaction_secrets/{transactionId} {
      allow read: if isAuthenticated() && resource.data.buyerId == request.auth.uid;
      allow write: if false;
    }

    match /disputes/{disputeId} {
      allow read: if isAuthenticated()
        && (
          isAdmin()
          || request.auth.uid in resource.data.get('participants', [])
        );
      allow create: if false; // backend-only via Cloud Functions
      allow update, delete: if false;
    }

    match /threads/{threadId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;
    }

    match /messages/{messageId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated()
        && request.resource.data.senderId == request.auth.uid
        && request.auth.uid in request.resource.data.participants;
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    match /ratings/{ratingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /idempotency/{key} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
